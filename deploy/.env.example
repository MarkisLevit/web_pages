# Copy to .env and fill in. NEVER commit .env to git.

# Public URL of the site (no trailing slash)
BASE_URL=https://yourdomain.com

# Stripe — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
# Created when you add the webhook endpoint (see README step 6)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# usd, eur or pln. Use pln if you want BLIK / Przelewy24 —
# those methods only work with PLN, and prices in server.js are in cents/grosze.
CURRENCY=usd

# Long random string. Your dashboard lives at /admin?token=THIS
ADMIN_TOKEN=change-me-to-something-long-and-random

PORT=3000
DB_PATH=/var/www/kindred/data/kindred.db
